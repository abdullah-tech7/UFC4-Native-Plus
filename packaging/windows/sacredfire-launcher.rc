// SacredFire (Windows): the application manifest and version block of the game executable
// and the other console programs (compiled with llvm-windres through CMake).
#include <winver.h>
1 24 "sacredfire-launcher.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,3,0,0
 PRODUCTVERSION 0,3,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SacredFire: native port of Crash Team Racing Nitro-Fueled (PS4) built on bbport"
            VALUE "InternalName", "SacredFire launcher"
            VALUE "LegalCopyright", "GPL-2.0-or-later. Contains code from bbport and shadPS4. Not affiliated with Sony, Activision or Beenox."
            VALUE "ProductName", "SacredFire"
            VALUE "ProductVersion", "0.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
